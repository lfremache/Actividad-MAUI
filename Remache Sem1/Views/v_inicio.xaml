<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Remache_Sem1.Views.v_inicio"
             Title="Cálculo del Aporte al IESS">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="28">

            <!-- Título Principal -->
            <Label Text="Cálculo de Aporte IESS"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#6D28D9" />

            <!-- Campo Nombre -->
            <Label Text="Nombre:" FontAttributes="Bold" />
            <Entry x:Name="txtNombre"
                   Placeholder="Ingrese su nombre"
                   HorizontalOptions="Fill" />

            <!-- Campo Apellido -->
            <Label Text="Apellido:" FontAttributes="Bold" />
            <Entry x:Name="txtApellido"
                   Placeholder="Ingrese su apellido"
                   HorizontalOptions="Fill" />

            <!-- Campo Edad -->
            <Label Text="Edad:" FontAttributes="Bold" />
            <Entry x:Name="txtEdad"
                   Placeholder="Ingrese su edad"
                   Keyboard="Numeric"
                   HorizontalOptions="Fill" />

            <!-- Campo Salario -->
            <Label Text="Salario ($):" FontAttributes="Bold" />
            <Entry x:Name="txtSalario"
                   Placeholder="Ej. 500.00"
                   Keyboard="Numeric"
                   HorizontalOptions="Fill" />

            <!-- Botón de Cálculo -->
            <Button Text="Calcular Aporte"
                    Clicked="OnCalcularClicked"
                    Margin="0,18,0,0"
                    BackgroundColor="#7C3AED"
                    TextColor="White"
                    CornerRadius="12"
                    HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
